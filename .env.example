# ── Server ──────────────────────────────────────────
PORT=3000
SESSION_SECRET=change_this_to_a_random_string_32chars

# ── Puppeteer / Chrome (اختياري) ─────────────────────
# على Railway يُضبط تلقائياً عبر nixpacks.toml
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# ── Environment ──────────────────────────────────────
NODE_ENV=production

# ── Persistent Storage (Railway Volume) ──────────────
# أضف Volume في Railway مربوط على /data ثم أضف هذا المتغير
# DATA_DIR=/data

# ── Email Verification (SMTP) ────────────────────────
# بدون هذه المتغيرات: الحسابات تُنشأ مباشرة بدون تحقق إيميل
# مثال Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password   (App Password من Google Account)
# SMTP_FROM=your@gmail.com
#
# مثال Brevo (Sendinblue):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_brevo_smtp_key

# --- PostgreSQL / Enterprise state -----------------------------------------
# Railway Postgres usually provides DATABASE_URL automatically.
# DATABASE_URL=postgresql://user:password@host:5432/database
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000

# Run once after provisioning Postgres:
# npm run db:migrate
# npm run migrate:json

# --- Redis / BullMQ ---------------------------------------------------------
# Railway Redis usually provides REDIS_URL automatically.
# REDIS_URL=redis://default:password@host:6379
INCOMING_MESSAGES_QUEUE=incoming-messages
AI_REPLIES_QUEUE=ai-replies
OUTGOING_WHATSAPP_QUEUE=outgoing-whatsapp
QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=15000

# --- AI Worker --------------------------------------------------------------
# Run as a separate Railway service/process:
# npm run worker:ai
AI_WORKER_CONCURRENCY=2
AI_WORKER_RATE_LIMIT_MAX=15
AI_WORKER_RATE_LIMIT_DURATION_MS=60000
AI_WORKER_LOCK_DURATION_MS=120000

# --- Railway process commands ----------------------------------------------
# Web service start command:
# npm run start:web
#
# Worker service start command:
# npm run worker:ai
#
# Optional single-container fallback:
# npm run start:all
# REQUIRE_WORKER=true
