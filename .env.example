# ── Server ──────────────────────────────────────────
PORT=3000
SESSION_SECRET=change_this_to_a_random_string_32chars

# ── Puppeteer / Chrome (اختياري) ─────────────────────
# على Railway يُضبط تلقائياً عبر nixpacks.toml
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# ── Environment ──────────────────────────────────────
NODE_ENV=production

# ── Persistent Storage (Railway Volume) ──────────────
# أضف Volume في Railway مربوط على /data ثم أضف هذا المتغير
# DATA_DIR=/data

# ── Email Verification (SMTP) ────────────────────────
# بدون هذه المتغيرات: الحسابات تُنشأ مباشرة بدون تحقق إيميل
# مثال Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password   (App Password من Google Account)
# SMTP_FROM=your@gmail.com
#
# مثال Brevo (Sendinblue):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_brevo_smtp_key

# --- PostgreSQL / Enterprise state -----------------------------------------
# Railway Postgres usually provides DATABASE_URL automatically.
# DATABASE_URL=postgresql://user:password@host:5432/database
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000

# Run once after provisioning Postgres:
# npm run db:migrate
# npm run migrate:json

# --- Redis / BullMQ ---------------------------------------------------------
# Railway Redis usually provides REDIS_URL automatically.
# REDIS_URL=redis://default:password@host:6379
INCOMING_MESSAGES_QUEUE=incoming-messages
AI_REPLIES_QUEUE=ai-replies
OUTGOING_WHATSAPP_QUEUE=outgoing-whatsapp
QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=15000

# --- AI Worker --------------------------------------------------------------
# Run as a separate Railway service/process:
# npm run worker:ai
# The dashboard controls memoryMessages. Default is 50 recent messages per conversation.
AI_WORKER_CONCURRENCY=2
AI_WORKER_RATE_LIMIT_MAX=15
AI_WORKER_RATE_LIMIT_DURATION_MS=60000
AI_WORKER_LOCK_DURATION_MS=180000

# --- Railway process commands ----------------------------------------------
# Web service start command:
# npm run start:web
#
# Worker service start command:
# npm run worker:ai
#
# Optional single-container fallback:
# npm run start:all
# REQUIRE_WORKER=true

# --- WhatsApp connection stability ------------------------------------------
WA_ENGINE=baileys
# Baileys shows QR in the hosted dashboard and stores auth in PostgreSQL.
# Use whatsapp-web only as an emergency fallback when Chromium/session storage is configured.
# WhatsApp Web uses a fast runtime Chrome profile and backs it up to DATA_DIR.
# Leave both empty on Railway unless you need an emergency override.
# WA_RUNTIME_SESSION_DIR=/tmp/jwab-wa-sessions
# WA_PERSISTENT_SESSION_DIR is intentionally not needed; DATA_DIR/data/<user-id>/session is used.
WA_AUTO_RECOVER=true
WA_AUTO_RECOVER_DELAY_MS=2500
WA_AUTH_TIMEOUT_MS=90000
WA_PROTOCOL_TIMEOUT_MS=120000
WA_LAUNCH_WATCHDOG_TIMEOUT_MS=30000
WA_QR_MAX_RETRIES=25
WA_QR_WATCHDOG_TIMEOUT_MS=90000
WA_READY_WATCHDOG_TIMEOUT_MS=120000
WA_AUTH_FAILURES_BEFORE_CLEAR=2
WA_KILL_CHROME_ON_START=true
WA_USE_PUPPETEER_BUNDLED=true
WA_STALE_WAITING_QR_RESTART_MS=45000
WA_WEB_VERSION_CACHE=local
# Optional emergency pin if WhatsApp Web latest breaks whatsapp-web.js.
# WA_WEB_VERSION=2.3000.1017054665
WA_WEB_VERSION_CACHE_REMOTE_PATH=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/{version}.html
WA_CONNECTION_LEASE_MS=120000
WA_LEASE_RETRY_MS=10000
WA_SESSION_BACKUP_DELAY_MS=30000
WA_SESSION_BACKUP_INTERVAL_MS=120000
# اتركه فارغاً ليُحسب تلقائياً حسب المحرّك: 3 ثوانٍ لـ Baileys، 20 ثانية لـ whatsapp-web.
# OUTGOING_CONNECTED_SETTLE_MS=
OUTGOING_STALE_JOB_MAX_AGE_MS=600000

# --- 24/7 Health Monitor & Owner Alerts -------------------------------------
# مراقب يفحص قاعدة البيانات وRedis والطوابير واتصال واتساب كل دقيقة وينبّه عند أي عطل.
# HEALTH_MONITOR_DISABLED=true   # لإيقاف المراقب كلياً
MONITOR_INTERVAL_MS=60000
MONITOR_FIRST_RUN_DELAY_MS=15000
# مدة بقاء واتساب خارج "متصل" قبل اعتباره عطلاً (مللي ثانية).
MONITOR_WA_STALE_MS=180000
# رقم واتساب المالك لاستقبال تنبيهات الأعطال (مع رمز الدولة، أرقام فقط).
# OWNER_ALERT_PHONE=9665XXXXXXXX
# بريد المالك لاستقبال تنبيهات الأعطال (يتطلب ضبط SMTP أعلاه).
# OWNER_ALERT_EMAIL=owner@example.com
# اختياري: معرّف مستخدم البوت الذي تُرسَل منه تنبيهات واتساب (افتراضياً أول حساب admin).
# OWNER_ALERT_USER_ID=

# Dashboard auth cookies. Use true on Railway HTTPS; use false only for local HTTP.
# COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# --- Billing / Owner admin --------------------------------------------------
# Secret owner dashboard URL path. Example: /owner-control-my-private-code
ADMIN_SECRET_PATH=/owner-control
# Admin emails are allowed to open the owner dashboard even if role is not admin.
ADMIN_EMAILS=owner@example.com
# Optional activation codes for free/manual customer access from /billing.
ADMIN_ACTIVATION_CODES=FREE-CUSTOMER-123
# 1750 SAR in halalas.
PLATFORM_ACCESS_PRICE_HALALAS=175000
# Message cost shown to the customer as usage information, not a token package.
MESSAGE_PRICE_HALALAS=0
BILLING_CURRENCY=SAR
# Keep true in production to block unpaid users from the dashboard and operational API routes.
BILLING_ACCESS_GATE_ENABLED=true
# Required to turn on live card and Apple Pay checkout on /billing.
APP_BASE_URL=https://your-railway-domain.up.railway.app
MOYASAR_PUBLISHABLE_KEY=pk_test_or_live_from_moyasar
MOYASAR_SECRET_KEY=sk_test_or_live_from_moyasar
# (انظر قسم Security أدناه لتفاصيل MOYASAR_WEBHOOK_SECRET)
MOYASAR_WEBHOOK_SECRET=
MOYASAR_APPLE_PAY_LABEL=Jwab

# ============================================================
# Security (added 2026-05-27 hardening)
# ============================================================

# مفتاح تشفير المفاتيح في DB — base64 لـ 32 بايت.
# توليد: node scripts/generate-secrets-key.js
# إلزامي في production. بدونه: تشفير admin_api_keys معطّل.
SECRETS_KEY=

# مفتاح توقيع webhook الدفع من Moyasar.
# يأخذ نفس قيمة الـ secret في لوحة تحكم Moyasar.
# webhook URL: https://YOUR_DOMAIN/billing/moyasar/webhook
# بدونه: endpoint يرجع 503 ولا يقبل أحداث الدفع.
# MOYASAR_WEBHOOK_SECRET=   (معرّف أعلاه في قسم Billing)

# هل يجب أن يكون الأدمن مسجل دخول كمستخدم عادي قبل تسجيل دخول الأدمن؟
# 'true' (افتراضي): آمن — يمنع انتحال صلاحية الأدمن بدون session.
# 'false': السلوك القديم (لا توصى به).
ADMIN_REQUIRE_USER_SESSION=true

# ============================================================
# Notifications (recommended)
# ============================================================

# رقم واتساب المالك لاستقبال تنبيهات:
# - فشل AI نهائي بعد كل المحاولات
# - رسائل @lid (رقم مخفي) لا يمكن الرد عليها
# - حوادث صحة النظام
# (موثّق أيضاً في قسم Health Monitor أعلاه)
# OWNER_ALERT_PHONE=9665XXXXXXXX

# إيميل المالك لنفس التنبيهات (إن أُضيف mailer)
# OWNER_ALERT_EMAIL=owner@example.com

# ============================================================
# Instagram DM (feature-flagged; separate from WhatsApp)
# ============================================================

# لا تشغّل العامل أو المسارات إلا بعد ضبط بقية القيم.
INSTAGRAM_ENABLED=false

# بيانات تطبيق Instagram Login — OAuth + توقيع X-Hub-Signature-256.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://YOUR_DOMAIN/instagram/auth/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_WEBHOOK_CALLBACK_URL=https://YOUR_DOMAIN/instagram/webhook
INSTAGRAM_GRAPH_VERSION=v25.0

# بيانات تطبيق Meta الأب على developers.facebook.com لفحص/تعديل اشتراك
# التطبيق عبر graph.facebook.com. هذه ليست مفاتيح Instagram Login أعلاه.
INSTAGRAM_META_APP_ID=
INSTAGRAM_META_APP_SECRET=

# اختياري: أسماء الطوابير ودورية تحديث التوكن.
# INCOMING_INSTAGRAM_QUEUE=incoming-instagram
# OUTGOING_INSTAGRAM_QUEUE=outgoing-instagram
# INSTAGRAM_TOKEN_REFRESH_INTERVAL_MS=86400000

# ============================================================
# WhatsApp tuning (optional — defaults are sane)
# ============================================================

# نافذة قبول الرسائل القديمة عند بدء worker، بالمللي ثانية.
# الافتراضي: 1800000 (30 دقيقة) — يمنع فقدان رسائل بعد redeploy.
# WA_ACCEPT_MESSAGES_GRACE_MS=1800000

# تأخير دنيا بين كل رسالتين صادرتين من نفس worker، بالمللي ثانية.
# الافتراضي: 800 — يجنّب تصنيف WhatsApp للحساب كـ spam.
# OUTGOING_MIN_INTERVAL_MS=800

# ============================================================
# AI tuning (optional)
# ============================================================

# درجة العشوائية للنموذج (0.0 = جاف، 1.0 = إبداعي)
# الافتراضي: 0.45 — توازن بين الثبات والطبيعية.
# AI_TEMPERATURE=0.45

# عقوبة تكرار المواضيع (0.0 - 2.0).
# الافتراضي: 0.6 — يقلل تكرار المواضيع في الرد.
# AI_PRESENCE_PENALTY=0.6

# عقوبة تكرار الكلمات (0.0 - 2.0).
# الافتراضي: 0.4 — يقلل تكرار نفس الكلمات.
# AI_FREQUENCY_PENALTY=0.4

# ============================================================
# عقل البوت (Phase 1: Grounding + Validation)
# اضبط أياً منها على false لإيقاف الطبقة فوراً والرجوع للسلوك القديم عند أي مشكلة.
# ============================================================
# حقن الردود الفورية (السياسات) في الـsystem prompt حتى يعرفها الـAI:
KNOWLEDGE_INJECTION_ENABLED=true
# التحقق بعد التوليد (طول + تصعيد حتمي + إصلاح تهرّب واحد):
REPLY_VALIDATOR_ENABLED=true
# مراجعة دلالية مستقلة للمسودة قبل الحفظ/الإرسال (نية + اكتمال + حقيقة + أسلوب):
REPLY_QUALITY_GATE_ENABLED=true
# مهلة المراجع المستقل. عند فشله لا يُرسل ادعاء غير مراجع؛ يُستخدم رد آمن صادق:
REPLY_QUALITY_GATE_TIMEOUT_MS=15000

# بعد هذا الانقطاع تُعامل الرسائل التالية كمحادثة جديدة ولا تُحقن المواضيع
# القديمة في التوليد أو المراجعة النهائية. الافتراضي: 21600000 (6 ساعات).
# AI_HISTORY_SESSION_GAP_MS=21600000
# PRE_SEND_REVIEW_SESSION_GAP_MS=21600000

# أمان الذاكرة بين العملاء: الردود المتعلمة من محادثة عميل لا تُحقن في
# محادثات عملاء آخرين افتراضياً. فعّلها فقط بعد مراجعة المحتوى واعتماده.
LEARNED_REPLIES_INJECTION_ENABLED=false

# ============================================================
# Post-deploy checklist (إجراءات لمرة واحدة بعد كل deploy لتغييرات schema)
# ============================================================
# 1. تشفير المفاتيح القديمة المخزّنة بنص واضح:
#    node scripts/encrypt-existing-api-keys.js
# 2. تحقق من registration لـ Moyasar webhook في لوحتهم:
#    URL: https://YOUR_DOMAIN/billing/moyasar/webhook
#    Events: paid, refunded
# 3. تحقق من أن SECRETS_KEY و MOYASAR_WEBHOOK_SECRET مضبوطين.
# 4. راقب لأول 24 ساعة:
#    - جدول escalation_log
#    - جدول health_incidents
#    - logs بحثاً عن "ai_failure_fallback" و "@lid"

# ── Stability: DB retention & cleanup (Phase 1) ──────────────────────────────
# تنظيف دوري آمن يمنع نمو جدولَي messages/jobs بلا حد (سبب انقطاع 2026-07-07).
# يحذف فقط الحالات النهائية الأقدم من مدة الاحتفاظ، على دفعات صغيرة، مع قفل نسخة
# واحدة. القيم الافتراضية آمنة؛ للتعطيل الفوري اضبط ENABLED=false.
STABILITY_CLEANUP_ENABLED=true
STABILITY_CLEANUP_DRY_RUN=false          # true = يحسب ما سيُحذف بدون حذف
STABILITY_CLEANUP_INTERVAL_MS=21600000   # كل 6 ساعات
STABILITY_MESSAGES_RETENTION_DAYS=90     # يُحفظ آخر 90 يوم من الرسائل النهائية
STABILITY_JOBS_RETENTION_DAYS=14         # يُحفظ آخر 14 يوم من المهام النهائية
STABILITY_CLEANUP_BATCH_SIZE=500
STABILITY_CLEANUP_MAX_BATCHES=200
STABILITY_CLEANUP_BATCH_DELAY_MS=100
STABILITY_CLEANUP_ANALYZE=true

# مراقبة حجم قاعدة البيانات (Phase 2): يفتح إنذاراً قبل امتلاء القرص.
# اضبط الحد الأقصى لحجم volume قاعدة البيانات (GB) لتفعيل تنبيهات النسبة.
STABILITY_DB_SIZE_CAP_GB=10              # حسب خطة Railway (مثال: 10GB)
STABILITY_DB_WARN_PCT=70                 # تحذير عند 70%
STABILITY_DB_CRITICAL_PCT=85             # حرج عند 85% (قبل الامتلاء بوقت كافٍ)

# شفاء ذاتي من فشل تشغيل الاتصال (Phase 3): عدد محاولات إعادة التشغيل المتقاربة
# قبل الاستقرار في حالة "خطأ" لتدخّل يدوي. backoff تصاعدي + jitter.
STABILITY_START_MAX_RETRIES=8

# موثوقية طابور الإرسال (Phase 4): إعادة فحص دورية تسترجع الردود العالقة بعد
# نافذة إعادة اتصال قبل أن تنتهي صلاحيتها (بدون تكرار الإرسال — الحارس قائم).
STABILITY_OUTGOING_REQUEUE_ENABLED=true
STABILITY_OUTGOING_REQUEUE_INTERVAL_MS=60000

# منع الإرسال المكرر (Phase 5): محاولات إعادة كتابة مرساة منع التكرار
# (whatsapp_message_id) عند فشل عابر لقاعدة البيانات، بدل ابتلاع الفشل صامتاً.
STABILITY_RECORD_SENDID_RETRIES=3

# كشف السوكِت الميت الصامت (Phase 7): لو السوكِت "مفتوح" لكن ما وصله أي إطار
# (keepalive ~20ث) لأطول من هذا الحد → يُعتبر zombie ويُعاد الاتصال. لا يتأثر
# الخمول الطبيعي لأن حركة keepalive تحدّث ساعة النشاط.
STABILITY_SOCKET_IDLE_MAX_MS=90000

# قناة إنذار مستقلة (Phase 8): رابط webhook خارجي (خدمة تنبيه/Slack/paging) يستقبل
# الإنذارات المهمة حتى لو واتساب أو قاعدة البيانات نفسها متعطّلة. اتركه فارغاً للتعطيل.
OWNER_ALERT_WEBHOOK_URL=
OWNER_ALERT_WEBHOOK_TIMEOUT_MS=5000

# CSRF صارم (Phase 10، اختياري): true = فحص same-origin لكل طلب تعديل على /api
# (ما عدا الـ webhooks). افتراضياً مطفأ (السلوك القديم) — فعّله بعد التحقق الحيّ.
STABILITY_STRICT_CSRF=false


# ── عقد خدمة العملاء (Customer-Service Contract) — سلوك منصّة آمن افتراضياً ──
# هذه الضوابط سلوكها الصحيح هو الافتراضي في الكود؛ المفاتيح هنا للـrollback فقط
# (kill-switch)، فلا يعتمد السلوك الآمن على تفعيل مفتاح على الإنتاج.

# طبقة عقد الخدمة (منع التصعيد/المراجعة الوهمية + منع اختراع خطوات حل غير موثّقة +
# أسبقية سياسة التصعيد + shadow-routing للتعليمات القديمة). افتراضياً مفعّلة.
# = false للتعطيل الكامل (رجوع للسلوك القديم).
SUPPORT_CONTRACT_ENABLED=true

# سلطة التعليمات (§2): botInstructions الطويلة تُقسَّم runtime إلى شخصية/أسلوب تابعة
# + كتلة حقائق التاجر الموثوقة، فلا تصير هي أساس البرومنت. افتراضياً مفعّل.
# = false يرجع للسلوك القديم (النص الحر يصير أساس البرومنت ويهيمن).
BOUNDED_BOT_INSTRUCTIONS_ENABLED=true
# حد أحرف كتلة الشخصية فقط (الحقائق التشغيلية لا تُقصّ).
BOT_INSTRUCTIONS_MAX_CHARS=1500

# الاختصار (§6): سقف طول الردّ متعدد الأسئلة = 2× بدل 3×. افتراضياً مفعّل.
# = false يرجع لـ3×.
BREVITY_AUTHORITY_ENABLED=true

# حذف حشو الخاتمة الحتمي (§6): «إذا احتجت شي أنا هنا…» تُحذف. افتراضياً مفعّل.
# = false للتعطيل.
CLOSING_FILLER_STRIP_ENABLED=true

# استهلاك طبقة Instruction Routing المنظّمة (SLA/سياسات/تصعيد منظّم) في البرومنت
# ووقت الرد. مستقل عن الطبقة أعلاه؛ يبقى opt-in.
INSTRUCTION_ROUTING_ENABLED=false
