# ── Server ──────────────────────────────────────────
PORT=3000
SESSION_SECRET=change_this_to_a_random_string_32chars

# ── Puppeteer / Chrome (اختياري) ─────────────────────
# على Railway يُضبط تلقائياً عبر nixpacks.toml
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# ── Environment ──────────────────────────────────────
NODE_ENV=production

# ── Persistent Storage (Railway Volume) ──────────────
# أضف Volume في Railway مربوط على /data ثم أضف هذا المتغير
# DATA_DIR=/data

# ── Email Verification (SMTP) ────────────────────────
# بدون هذه المتغيرات: الحسابات تُنشأ مباشرة بدون تحقق إيميل
# مثال Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password   (App Password من Google Account)
# SMTP_FROM=your@gmail.com
#
# مثال Brevo (Sendinblue):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_brevo_smtp_key
