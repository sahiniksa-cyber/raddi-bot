# ── Server ──────────────────────────────────────────
PORT=3000
SESSION_SECRET=change_this_to_a_random_string_32chars

# ── Puppeteer / Chrome (اختياري) ─────────────────────
# على Railway يُضبط تلقائياً عبر nixpacks.toml
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# ── Environment ──────────────────────────────────────
NODE_ENV=production
