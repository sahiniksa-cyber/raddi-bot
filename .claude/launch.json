{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "preview-dashboard",
      "runtimeExecutable": "node",
      "runtimeArgs": [".claude/preview-server.js"],
      "port": 3100
    },
    {
      "name": "mockup-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const http=require('http'),fs=require('fs'),path=require('path');http.createServer((req,res)=>{const f=path.join(process.cwd(),'.claude','conversations-mockup.html');fs.readFile(f,(e,d)=>{if(e){res.writeHead(404);res.end('not found');}else{res.writeHead(200,{'Content-Type':'text/html;charset=utf-8'});res.end(d);}});}).listen(3101,()=>console.log('mockup on http://localhost:3101'));"],
      "port": 3101
    }
  ]
}
