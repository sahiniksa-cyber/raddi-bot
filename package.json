{
  "name": "jwab-whatsapp-bot",
  "version": "1.0.0",
  "description": "جواب — بوت واتساب ذكي لخدمة العملاء",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/runtime/start-all.js",
    "dev": "node src/server.js",
    "start:web": "node src/server.js",
    "start:all": "node src/runtime/start-all.js",
    "db:migrate": "node src/db/migrations/init.js",
    "db:compact-message-media": "node scripts/compact-message-media.js",
    "migrate:json": "node scripts/migrate-json-to-postgres.js",
    "worker:ai": "node src/workers/ai-worker.js",
    "test": "node --test",
    "simulate:stabilization": "node scripts/simulate-stabilization.js --seed 20260726 --sequences 10000 --report docs/stabilization/simulation-report.json",
    "test:critical-mutations": "node scripts/run-critical-mutations.js --report docs/stabilization/mutation-report.json"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc10",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "bullmq": "^5.76.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "express-session": "^1.19.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^4.47.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "puppeteer-core": "24.43.1",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "session-file-store": "^1.5.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
